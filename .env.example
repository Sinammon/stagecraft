# Keep this key on the server. Never prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Set these to the active project quotas shown in Google AI Studio.
GEMINI_RPM=5
GEMINI_TPM=100000
GEMINI_RPD=100
GEMINI_TIMEOUT_MS=90000
# Keep false for local HTTP; use true with HTTPS in production.
SECURE_COOKIES=false
